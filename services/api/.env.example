PORT=8080
WEB_ORIGIN=http://localhost:3000
CMC_API_KEY=

# paper (default) never sends exchange orders. Set live explicitly for real trading.
ARBIVIEW_TRADING_MODE=paper
MAX_SLIPPAGE_BPS=50
POSITION_TOLERANCE_USDT=10

BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Telegram Bot (long polling). Restrict commands to one chat, and optionally
# to a comma-separated list of Telegram user IDs inside that chat.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
TELEGRAM_AUTHORIZED_USERS=

# Optional durable storage for Telegram/API automatic close rules.
AUTO_CLOSE_STATE_PATH=
